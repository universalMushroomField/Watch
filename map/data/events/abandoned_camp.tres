[gd_resource type="Resource" script_class="MapEventData" load_steps=4 format=3]

[ext_resource type="Script" path="res://map/content/map_event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://map/content/map_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_search"]
script = ExtResource("2_choice")
label = "翻找营地"
