result_text = "你借着余温恢复了一点体力。"
health_delta = 6

[resource]
script = ExtResource("1_event")
id = &"abandoned_camp"
title = "废弃营地"
body = "营火早已熄灭，帐篷被风吹得破破烂烂。这里也许还留着能用的东西。"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_search"), SubResource("Resource_rest")])
